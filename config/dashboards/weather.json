{
  "id": "weather",
  "title": "Hoboken Weather & Forecast",
  "description": "Current conditions, temperature hero, and upcoming 4-day forecast",
  "version": 1,
  "layout": {
    "type": "vstack",
    "padding_x": 20,
    "gap": 10,
    "children": [
      {
        "type": "header",
        "badge": "WEATHER",
        "title": "HOBOKEN LOCAL FORECAST",
        "subtitle": "MILE SQUARE METEOROLOGY & CONDITIONS",
        "show_time": true,
        "show_battery": true,
        "show_date": true,
        "height": 62
      },
      {
        "type": "hstack",
        "flex": 1.7,
        "gap": 14,
        "children": [
          {
            "type": "weather_hero",
            "flex": 2.1,
            "show_details": true
          },
          {
            "type": "metric_card",
            "flex": 1.0,
            "title": "PRECIPITATION",
            "source": "precip_prob",
            "unit": "%",
            "subtitle": "Rain probability",
            "badge": "RADAR"
          }
        ]
      },
      {
        "type": "weather_forecast",
        "flex": 1.0,
        "days": 4
      },
      {
        "type": "button_bar",
        "height": 42
      }
    ]
  }
}
