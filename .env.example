# ==============================================================================
# Transit Tracker Environment Configuration Template
# Copy this file to .env and configure as needed: cp .env.example .env
# ==============================================================================

# --- Server & Network ---
# HTTP Port (defaults to 8000)
PORT=8000

# Timezone for countdowns and schedule state transitions
TZ=America/New_York

# --- NJ Transit Developer API Credentials ---
# Register for free at: https://developer.njtransit.com/registration
# Note: Username handle (the part before @ if registered with email) is used.
NJT_USERNAME=your_username_here
NJT_PASSWORD=your_password_here

# Optional: NJ Transit BUSDV2 & GTFS API Base URLs (defaults to production https://pcsdata.njtransit.com)
# NJT_BASE_URL=https://pcsdata.njtransit.com
# NJT_GTFS_BASE_URL=https://pcsdata.njtransit.com

# --- Security & Control Plane ---
# Secret token required for administrative endpoints (/schedule, /mode, /action, /diag).
# If left empty, a secure token is generated on startup and logged to stdout / stored in cache.
# TRACKER_CONTROL_TOKEN=your_secure_secret_token

# --- Kindle Client Runtime Mode ---
# Desired mode reported to Kindle clients: sleep-suspend (default), resident, or oneshot.
TRACKER_DEFAULT_MODE=sleep-suspend

# --- Schedule Configuration ---
# Path to custom schedule state machine configuration (JSON).
# Hot-reloads automatically on change without restarting the server.
# SCHEDULE_CONFIG=config/schedule.json

# --- Legacy Window & Interval Overrides (Optional) ---
# Decimal hours for peak commute and overnight windows (e.g. 7.5 = 7:30 AM)
# PEAK_AM_START=7.5
# PEAK_AM_END=9.5
# PEAK_PM_START=16.5
# PEAK_PM_END=19.0
# PEAK_WEEKENDS=0
# OVERNIGHT_START=22.0
# OVERNIGHT_END=6.0
# OFFPEAK_INTERVAL=600
# OVERNIGHT_INTERVAL=3600
# FORCE_FAST_POLL=0

# --- Docker & Release Signing ---
# Set to 1 for unsigned development builds without OTA signing keys.
ALLOW_UNSIGNED_OTA=1
# Path to Ed25519 private key generated via 'make keygen' (for signed production releases).
# OTA_SIGNING_KEY_FILE=secrets/ota_ed25519.key
